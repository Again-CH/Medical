# 模型模式：fake | ollama | openai | qwen
# 真实落地默认走本地 Ollama（无需任何 API key，本机可跑）；CI 评测可用 fake
LLM_MODE=ollama

# Ollama（本地模型，推荐用于本机无 OpenAI key 的场景）
# 已验证可用：ollama pull qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Qwen（OpenAI 兼容，私有化部署满足数据不出域）
QWEN_MODEL=qwen-plus

# 安全：生产务必替换为强随机值
JWT_SECRET=dev-secret-change-me
# CORS：演示默认 *；生产请改为具体前端域名
CORS_ORIGINS=*

# 生产级持久化（核心）：设置 DATABASE_URL 后，号源/预约/用户/审批/记忆全部落地数据库。
# 未设置时回退为离线内存 demo 模式（get_hub 返回 MemoryHub），脚手架仍开箱即跑。
# 本地 brew Postgres 示例（已在本机起好）：
DATABASE_URL=postgresql+psycopg2://mac@localhost:5432/medical_agent
# 本地零依赖开发也可用 SQLite 跑通同构 SQL：
# DATABASE_URL=sqlite:///./medical_agent.db

# 审批存储：本项已并入 DATABASE_URL（Postgres/SQLite）；仅当未设置 DATABASE_URL 时
# 才回退到内存/JSON 文件（:memory: 或 ./approvals.json）
APPROVAL_STORE=:memory:

# ---- LangSmith 链路追踪（可选）----
# 设为 true 后，langgraph 每次运行自动上报到 LangSmith（用于链路追踪 + 离线评测联动）
# 需配合 LANGSMITH_API_KEY（在 https://smith.langchain.com 获取）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-agent
