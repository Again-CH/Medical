# 模型模式：fake | ollama | openai | qwen
# fake 为默认，确定性、无需任何外部 API，脚手架开箱即跑
LLM_MODE=fake

# Ollama（本地模型，推荐用于本机无 OpenAI key 的场景）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Qwen（OpenAI 兼容，私有化部署满足数据不出域）
QWEN_MODEL=qwen-plus

# 安全
JWT_SECRET=dev-secret-change-me
# CORS：演示默认 *；生产请改为具体前端域名
CORS_ORIGINS=*

# 审批存储：:memory: 或 json 文件路径（如 ./approvals.json）
APPROVAL_STORE=:memory:

# 生产级持久化（可选）：设置 DATABASE_URL 后审批/审计自动落地 PostgreSQL
# 未设置时回退到上面的 APPROVAL_STORE（内存/JSON 文件），脚手架仍开箱即跑
# DATABASE_URL=postgresql://med_user:med_pass@localhost:5432/med_agent

# ---- LangSmith 链路追踪（可选）----
# 设为 true 后，langgraph 每次运行自动上报到 LangSmith（用于链路追踪 + 离线评测联动）
# 需配合 LANGSMITH_API_KEY（在 https://smith.langchain.com 获取）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-agent
