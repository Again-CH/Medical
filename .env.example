# 模型模式：fake | ollama | openai | qwen
# 真实落地默认走本地 Ollama（无需任何 API key，本机可跑）；CI 评测可用 fake
LLM_MODE=ollama

# Ollama（本地模型，推荐用于本机无 OpenAI key 的场景）
# 已验证可用：ollama pull qwen2.5:1.5b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Qwen（OpenAI 兼容，私有化部署满足数据不出域）
QWEN_MODEL=qwen-plus

# 运行环境：development | production
# production 下对密钥强度、CORS 配置做硬校验，缺失/不达标直接拒绝启动
APP_ENV=development

# 安全：生产务必替换为强随机值（建议 secrets.token_urlsafe(32)，≥32 字节）
# 留空时：development 自动生成临时密钥（重启失效），production 直接拒绝启动
JWT_SECRET=
# JWT 密钥最小长度（字节），低于此值 production 拒绝启动
JWT_SECRET_MIN_BYTES=32

# ---- 认证安全调优 ----
# 访问令牌有效期（分钟）：短时效，降低泄露影响面（默认 15）
JWT_ACCESS_EXP_MINUTES=15
# 刷新令牌有效期（天）：用于无感续期（默认 7）
JWT_REFRESH_EXP_DAYS=7
# JWT 签发方标识（用于校验 iss，防篡改跨服务令牌）
JWT_ISSUER=medical-agent
# 账号防爆破：连续失败达到次数即锁定（默认 5）
ACCOUNT_LOCKOUT_ATTEMPTS=5
# 锁定时长（分钟，默认 15）
ACCOUNT_LOCKOUT_MINUTES=15
# 密码哈希轮数（PBKDF2-HMAC-SHA256，默认 60 万；建议 ≥ 60 万，越高越抗暴力）
PBKDF2_ROUNDS=600000

# ---- 传输安全（Tier-1，必做）----
# 当前网关为明文 HTTP。生产必须在反向代理（Nginx/Caddy）层终止 TLS 并启用：
#   - HTTPS（HSTS 已在前端响应头声明，需 TLS 才生效）
#   - WAF / 限流 / 防 CC
#   - 证书由受信任 CA 签发，私钥不落 .env（走 KMS/密钥管理）


# CORS：逗号分隔的前端域名白名单；演示默认 *；生产务必改为具体域名（如 http://localhost:8080）
# production 且本项为空 → 收紧为不放行任何跨域（同源部署不受影响）
CORS_ORIGINS=*

# 注册开关：true 开放注册 | false 关闭（改为邀请码/后台开通，防垃圾账号）
REGISTER_ENABLED=true

# 速率限制：true 开启（按 IP+路由，见 src/config.py RATE_LIMIT_RULES）
RATE_LIMIT_ENABLED=true

# 输入约束
MAX_MESSAGE_LEN=2000        # 单条对话消息上限
MIN_PASSWORD_LEN=8          # 密码最小长度（≥8）
MIN_USERNAME_LEN=3          # 用户名最小长度
# 密码复杂度：要求同时含字母与数字（默认 true）
PASSWORD_REQUIRE_COMPLEXITY=true

# ---- 安全加固（2026-08-29 安全审计后新增）----

# 反代信任：仅当部署在可信反向代理之后才置 true，才采信 X-Forwarded-For。
# 置 false（默认）时限流/审计一律使用 TCP 对端 IP —— 否则攻击者每次请求换一个
# XFF 即可重置配额，令限流形同虚设并污染审计记录。
TRUST_PROXY=false

# 鉴权失败模式：吊销校验（token_version）因 DB 故障不可用时如何处置。
# fail_closed（默认/生产推荐）：拒绝请求 —— 医疗系统宁可短暂不可用，也不放行已作废令牌。
# fail_open：放行（仅可用性优先且无合规要求的演示环境）。
AUTH_FAIL_MODE=fail_closed

# 刷新令牌绝对有效期（天）：超过后即便持续续期也必须重新登录。
# 防止「滑动续期」让令牌无限期有效（设备丢失/令牌泄露后无法收敛）。
REFRESH_ABSOLUTE_EXP_DAYS=30

# 管理员开通医护账号的共享密钥（POST /admin/doctors 使用）。
# 医护**绝不允许自助注册**——否则任何人可提权读取全部患者数据与审批敏感操作。
# 未设置时 /admin/doctors 直接拒绝开通。生产请用：openssl rand -base64 32
ADMIN_API_KEY=

# PHI 出境策略（医疗数据合规红线）
# strict（默认）：仅允许本地/私有化端点，外网端点直接拒绝启动 —— 数据不出域。
# masked：允许出境，但患者文本在离开本机前先做 PII/PHI 脱敏。
# allow ：原样出境，不做处理（仅限无真实患者数据的本地开发）。
# ⚠️ 接入真实患者数据前，务必改用本地/私有化模型，或完成出境安全评估与患者单独同意。
LLM_EGRESS_POLICY=strict
# 私有化/内网端点白名单（host，逗号分隔），strict 模式下命中即视为合规出境
LLM_PRIVATE_HOSTS=localhost,127.0.0.1,host.docker.internal,::1

# CSP 严格模式：true 用 nonce 放行内联脚本（默认，彻底杜绝 XSS 注入脚本）；
# false 回退 unsafe-inline（仅用于尚未完成事件委托迁移的前端）。
CSP_STRICT=true

# 单患者单日挂号上限：防 Agent 失控循环或恶意囤号耗尽号源
MAX_APPOINTMENTS_PER_DAY=5

# 生产级持久化（核心）：设置 DATABASE_URL 后，号源/预约/用户/审批/记忆全部落地数据库。
# 未设置时回退为离线内存 demo 模式（get_hub 返回 MemoryHub），脚手架仍开箱即跑。
# 本地 brew Postgres 示例（已在本机起好）：
DATABASE_URL=postgresql+psycopg2://mac@localhost:5432/medical_agent
# 本地零依赖开发也可用 SQLite 跑通同构 SQL：
# DATABASE_URL=sqlite:///./medical_agent.db

# 审批存储：本项已并入 DATABASE_URL（Postgres/SQLite）；仅当未设置 DATABASE_URL 时
# 才回退到内存/JSON 文件（:memory: 或 ./approvals.json）
APPROVAL_STORE=:memory:

# ---- LangSmith 链路追踪（可选）----
# 设为 true 后，langgraph 每次运行自动上报到 LangSmith（用于链路追踪 + 离线评测联动）
# 需配合 LANGSMITH_API_KEY（在 https://smith.langchain.com 获取）
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=medical-agent
